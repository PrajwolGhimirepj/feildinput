{
  "manifest_version": 3,
  "name": "Field Inject",
  "version": "1.2.0",
  "description": "Fill website fields from an always-on-top window, with optional English-to-Nepali translation powered by Google Translate.",
  "minimum_chrome_version": "119",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Field Inject",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_origin_as_fallback": true
  }]
}
